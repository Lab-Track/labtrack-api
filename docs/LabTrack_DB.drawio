        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot; erDiagram                                                                        \n      PROFESSOR ||--o{ PROJECT : advises                                           \n      PROFESSOR ||--o{ LOAN : \&quot;responsible for\&quot;                                    \n      STUDENT ||--o{ LOAN : requests                                               \n      TECHNICIAN ||--o{ LOAN : registers                                           \n      TECHNICIAN ||--o{ STATUS_HISTORY : updates                                   \n      PROJECT |o--o{ EQUIPMENT : groups                                            \n      EQUIPMENT ||--o{ LOAN_ITEM : \&quot;is loaned in\&quot;                                  \n      EQUIPMENT ||--o{ STATUS_HISTORY : has                                        \n      LOAN ||--o{ LOAN_ITEM : contains                                             \n      LOAN ||--o{ NOTIFICATION : generates                                         \n      LOAN_ITEM ||--o| LOAN_RETURN : generates                                     \n                                                                                   \n      STUDENT {                                                                    \n          int id PK                                                                \n          string registration_number UK \&quot;optional; RN06\&quot;                           \n          string name                                                              \n          string email                                                             \n          string phone                                                             \n          decimal reliability_rate \&quot;percentage, default 100; RF13\&quot;                 \n          datetime registration_date                                               \n      }                                                                            \n      PROFESSOR {                                                                  \n          int id PK                                                                \n          string name                                                              \n          string email                                                             \n      }                                                                            \n      TECHNICIAN {                      \n          int id PK\n          string name\n          string login UK\n          string password_hash\n          string email\n      }\n      PROJECT {\n          int id PK\n          string name\n          int professor_id FK\n      }\n      EQUIPMENT {\n          int id PK\n          string name\n          string identification_photo \&quot;required - item identifier, EA01\&quot;\n          string current_status \&quot;available/loaned/maintenance/damaged\&quot;\n          int project_id FK \&quot;optional\&quot;\n      }   \n      STATUS_HISTORY {\n          int id PK\n          int equipment_id FK\n          string previous_status\n          string new_status \n          datetime change_date\n          int technician_id FK\n      }   \n      LOAN {\n          int id PK\n          int student_id FK\n          int responsible_professor_id FK \&quot;also authorizes when student has no\n  registration number\&quot;\n          int technician_id FK\n          datetime checkout_date \n          datetime expected_return_date\n          datetime extended_date \&quot;optional\&quot;\n          string loan_status \&quot;in_progress/late/returned/partial\&quot;\n      }   \n      LOAN_ITEM {\n          int id PK\n          int loan_id FK\n          int equipment_id \n       string checkout_photo \&quot;required; RN04\&quot;                                   \n          string checkout_condition                                                \n          string item_status \&quot;loaned/returned/removed\&quot;                             \n      }                                                                            \n      LOAN_RETURN {                                                                \n          int id PK                                                                \n          int loan_item_id FK \&quot;unique - 1 return per item\&quot;                         \n          datetime return_date                                                     \n          string return_condition                                                  \n          string notes                                                             \n          string verification_status \&quot;working/defective/not_tested\&quot;                \n          boolean overdue \&quot;flags the student\&quot;                                      \n      }                                                                            \n      NOTIFICATION {                                                               \n          int id PK                                                                \n          int loan_id FK                                                           \n          datetime sent_date                                                       \n          string channel                                                           \n          string delivery_status                                                   \n      }                                   &quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6QX6h6pwIpbG04eE06RY-2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
